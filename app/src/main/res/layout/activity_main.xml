<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Mejora 1: AutoCompleteTextView para el camarero -->
        <AutoCompleteTextView
            android:id="@+id/actvCamarero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_camarero"
            android:completionThreshold="3"
            android:layout_marginBottom="16dp"/>

        <!-- Total de la cuenta -->
        <EditText
            android:id="@+id/etTotalCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_total"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp"/>

        <!-- CheckBox para propina -->
        <CheckBox
            android:id="@+id/cbPropina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_propina"
            android:layout_marginBottom="8dp"/>

        <!-- TextView y SeekBar para ajustar propina -->
        <TextView
            android:id="@+id/tvPorcentajePropina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_propina" />

        <SeekBar
            android:id="@+id/seekBarPropina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="10"
            android:layout_marginBottom="16dp"/>

        <!-- RadioGroup para método de pago -->
        <RadioGroup
            android:id="@+id/rgMetodoPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbEfectivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/radio_efectivo"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbTarjeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/radio_tarjeta"
                android:layout_marginStart="16dp"/>
        </RadioGroup>

        <!-- RatingBar para calificar servicio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calificación del servicio:" />

        <RatingBar
            android:id="@+id/ratingBarServicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:rating="3.0"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Botón de calcular -->
        <Button
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_calcular"
            android:layout_marginBottom="24dp"/>

        <!-- TextView de resultados y errores -->
        <TextView
            android:id="@+id/tvResultadoFinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_resultado"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>